# Postgres connection string used by cms/src/payload.config.ts (@payloadcms/db-postgres).
# On a serverless host (Vercel), use your provider's *pooled* connection string
# (Neon/Vercel Postgres both offer one, usually with `-pooler` in the hostname)
# — serverless functions open a fresh connection per invocation far more often
# than a long-lived server would, and the pooled endpoint is what keeps that
# from exhausting the database's own connection limit. The connection string
# a managed provider gives you already includes `?sslmode=require`; keep that
# query param, don't strip it.
DATABASE_URI=postgres://user:password@localhost:5432/italy_tours

# Payload's field-encryption / session secret — generate a long random value per
# environment, e.g. `openssl rand -base64 32`. Never reuse the same value across
# local/staging/production.
PAYLOAD_SECRET=

# Public origin of the Next.js app; used as the Payload serverURL/CSRF allowlist
# and by the afterChangePublishRevalidate hook to reach /api/internal/revalidate.
# Safe to leave unset on Vercel — cms/src/lib/resolveServerUrl.ts falls back to
# Vercel's own auto-injected VERCEL_URL when this isn't set, so the very first
# deploy doesn't need it. Set it explicitly once a custom domain is attached
# (VERCEL_URL only ever points at the *.vercel.app deployment URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the CMS sends to /api/internal/revalidate — must match on both
# sides. Generate the same way as PAYLOAD_SECRET; the two must NOT be the same
# value as each other.
REVALIDATE_SECRET=

# Password for the local owner/admin user cms/src/seed/createOwnerUser.ts creates.
# Optional — omit it and the script generates + prints a random one instead.
OWNER_PASSWORD=
