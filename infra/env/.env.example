# Postgres connection string used by cms/src/payload.config.ts (@payloadcms/db-postgres)
DATABASE_URI=postgres://user:password@localhost:5432/italy_tours

# Payload's field-encryption / session secret — generate a long random value per environment
PAYLOAD_SECRET=

# Public origin of the Next.js app; used as the Payload serverURL and by the
# afterChangePublishRevalidate hook to reach /api/internal/revalidate
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the CMS sends to /api/internal/revalidate — must match on both sides
REVALIDATE_SECRET=
