# Firebase Admin SDK (server-side only, Node runtime) — from your Firebase
# project's service account key (Project Settings -> Service accounts ->
# Generate new private key). Never commit the downloaded JSON file itself;
# these three fields are pulled out of it into plain env vars instead, so the
# same three work identically in local dev and in Vercel's dashboard env
# vars (which has no persistent filesystem to reference a JSON file from).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences — env vars can't hold real
# newlines, so the private key's line breaks are escaped; packages/firebase's
# client.ts un-escapes them back to real newlines before use.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret checked by /api/internal/revalidate before invalidating an
# ISR cache tag. Generate a long random value, e.g. `openssl rand -base64 32`.
REVALIDATE_SECRET=
