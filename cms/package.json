{
  "name": "@italy-tours/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/payload.config.ts",
  "types": "./src/payload.config.ts",
  "exports": {
    ".": "./src/payload.config.ts",
    "./payload.config": "./src/payload.config.ts",
    "./importMap": "./src/app/(payload)/admin/importMap.js",
    "./collections/*": "./src/collections/*.ts"
  },
  "scripts": {
    "build": "payload generate:importmap && payload generate:types",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "seed:demo": "dotenv -e ../infra/env/.env -- tsx src/seed/seedDemoSite.ts",
    "seed:templates": "dotenv -e ../infra/env/.env -- tsx src/seed/seed-templates.ts",
    "site:publish": "dotenv -e ../infra/env/.env -- tsx src/seed/publishSite.ts",
    "seed:streetfoodrome": "dotenv -e ../infra/env/.env -- tsx src/seed/seedStreetFoodRome.ts",
    "seed:instagram-offer": "dotenv -e ../infra/env/.env -- tsx src/seed/seedInstagramOfferPage.ts",
    "seed:food-match": "dotenv -e ../infra/env/.env -- tsx src/seed/seedFoodMatchPage.ts",
    "site:delete": "dotenv -e ../infra/env/.env -- tsx src/seed/deleteSite.ts",
    "create:owner": "dotenv -e ../infra/env/.env -- tsx src/seed/createOwnerUser.ts",
    "backfill:owner": "dotenv -e ../infra/env/.env -- tsx src/seed/backfillOwner.ts",
    "governance:scan": "dotenv -e ../infra/env/.env -- tsx src/seed/governanceScan.ts"
  },
  "dependencies": {
    "@italy-tours/config": "workspace:*",
    "@italy-tours/governance": "workspace:*",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "payload": "^3.0.0"
  },
  "devDependencies": {
    "@italy-tours/tsconfig": "workspace:*",
    "@types/node": "^20.14.0",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4"
  }
}
